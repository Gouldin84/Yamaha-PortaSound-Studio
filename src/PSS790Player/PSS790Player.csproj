<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>PSS790Player</RootNamespace>
    <AssemblyName>PSS-Studio</AssemblyName>
    <Authors>Gouldin84</Authors>
    <Company>Gouldin84</Company>
    <Product>Yamaha PortaSound Studio</Product>
    <Copyright>Copyright © 2026 Gouldin84</Copyright>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    
    <!-- Standalone Single-File Configuration -->
    <Version>2.5.7</Version>
    <AssemblyVersion>2.5.7</AssemblyVersion>
    <FileVersion>2.5.7</FileVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Melanchall.DryWetMidi" Version="8.0.3" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <EmbeddedResource Include="Assets\app.ico" />
    <EmbeddedResource Include="WebUI\**\*" />
    <Content Include="WebUI\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
