@inject AppStateStore State
@inject LibraryService Library

<div id="settingsModal" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/80 backdrop-blur-sm p-3">
    <div class="glass-panel p-5 sm:p-6 rounded-2xl border border-slate-800 max-w-xl w-full mx-auto shadow-2xl space-y-4 max-h-[90vh] flex flex-col">
        <div class="flex items-center justify-between border-b border-slate-800 pb-3 shrink-0">
            <div class="flex items-center space-x-2.5">
                <div class="w-8 h-8 rounded-xl bg-cyan-500/20 text-cyan-400 flex items-center justify-center font-bold text-sm">⚙️</div>
                <div>
                    <h3 class="text-sm font-bold text-white">Studio Settings</h3>
                    <p class="text-[11px] text-slate-400">Library Storage Location &amp; System Configuration</p>
                </div>
            </div>
            <button type="button" @onclick="Close" class="text-slate-400 hover:text-white transition text-lg">✕</button>
        </div>

        <div class="flex-1 min-h-0 overflow-y-auto custom-scrollbar space-y-4 pr-1">
            <div class="p-3.5 rounded-xl bg-slate-900/90 border border-slate-800 space-y-3">
                <div class="flex items-center justify-between">
                    <label class="text-xs font-bold text-white">📁 Library Storage Root</label>
                    <span class="px-2 py-0.5 rounded-full text-[9px] font-bold border @(State.IsCustomLibraryRoot ? "bg-cyan-950 text-cyan-300 border-cyan-700" : "bg-slate-800 text-slate-400 border-slate-700")">
                        @(State.IsCustomLibraryRoot ? "Custom Path" : "Default Path")
                    </span>
                </div>
                <p class="text-[11px] text-slate-400 leading-relaxed">
                    Specify where your MIDI library, SysEx vaults, and recordings are stored. Supports local folders, mapped drives, and NAS paths.
                </p>
                <div class="flex items-center space-x-2">
                    <input type="text" value="@_rootDraft" @oninput="(e) => _rootDraft = e.Value?.ToString() ?? string.Empty"
                           class="flex-1 px-3 py-2 rounded-xl bg-slate-950 border border-slate-700/80 text-xs text-white font-mono focus:outline-none focus:border-cyan-500" />
                    <button type="button" @onclick="Browse" class="px-3 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-white border border-slate-700 shrink-0">📂 Browse...</button>
                </div>
                <button type="button" @onclick="Reset" class="text-[11px] text-cyan-400 hover:text-cyan-300 underline font-medium cursor-pointer">
                    ↺ Reset to Default (@State.DefaultLibraryRoot)
                </button>
            </div>

            <div class="p-3.5 rounded-xl bg-slate-900/60 border border-slate-800/80 space-y-2">
                <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block">Managed Directory Structure</span>
                <div class="grid grid-cols-2 gap-2 text-[10px] font-mono">
                    <div class="p-2 rounded-lg bg-slate-950/80 border border-slate-800/60 text-slate-300"><span class="text-emerald-400 font-bold block">/GM Midi</span><span class="text-slate-500 text-[9px]">Original GM source files</span></div>
                    <div class="p-2 rounded-lg bg-slate-950/80 border border-slate-800/60 text-slate-300"><span class="text-cyan-400 font-bold block">/PSS-790 Midi</span><span class="text-slate-500 text-[9px]">AWM optimized playback</span></div>
                    <div class="p-2 rounded-lg bg-slate-950/80 border border-slate-800/60 text-slate-300"><span class="text-amber-400 font-bold block">/PSS-680 Midi</span><span class="text-slate-500 text-[9px]">2-Op FM remapped files</span></div>
                    <div class="p-2 rounded-lg bg-slate-950/80 border border-slate-800/60 text-slate-300"><span class="text-indigo-400 font-bold block">/SysEx Library</span><span class="text-slate-500 text-[9px]">FM patches &amp; Vector presets</span></div>
                </div>
            </div>
        </div>

        <div class="flex items-center justify-end space-x-2 border-t border-slate-800 pt-3 shrink-0">
            <button type="button" @onclick="Close" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-slate-300">Cancel</button>
            <button type="button" @onclick="Save" class="px-5 py-2 rounded-xl bg-gradient-to-r from-cyan-600 to-cyan-500 hover:from-cyan-500 hover:to-cyan-400 text-xs font-bold text-white shadow-lg">Save &amp; Apply</button>
        </div>
    </div>
</div>

@code {
    private string _rootDraft = string.Empty;

    protected override void OnInitialized() => _rootDraft = State.LibraryRoot;

    private void Browse()
    {
        var picked = Library.BrowseLibraryFolder();
        if (!string.IsNullOrWhiteSpace(picked)) _rootDraft = picked;
    }

    private void Reset()
    {
        Library.ResetLibraryRoot();
        Close();
    }

    private void Save()
    {
        if (!string.IsNullOrWhiteSpace(_rootDraft))
        {
            Library.SaveLibraryRoot(_rootDraft.Trim());
        }
        Close();
    }

    private void Close() => State.Mutate(s => s.ShowSettingsModal = false);
}
