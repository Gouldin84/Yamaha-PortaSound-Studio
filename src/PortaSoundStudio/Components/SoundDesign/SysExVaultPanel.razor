@inherits StudioComponentBase
@inject SoundDesignService SoundDesign

@{
    bool is680 = string.Equals(State.ActiveModel, "pss680", StringComparison.OrdinalIgnoreCase);
    var modelDumps = State.SysExDumps
        .Where(d => SysExManager.IsDumpCompatibleWithModel(d, State.ActiveModel))
        .ToList();
    var filteredDumps = string.IsNullOrWhiteSpace(_searchQuery)
        ? modelDumps
        : modelDumps.Where(d => d.FileName.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                                d.DumpType.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase)).ToList();
    var selectedDump = modelDumps.FirstOrDefault(d => string.Equals(d.FilePath, _selectedDumpPath, StringComparison.OrdinalIgnoreCase))
                       ?? filteredDumps.FirstOrDefault();
}

<div id="deckBulkDumps" class="w-full h-full flex flex-col lg:flex-row gap-3 min-h-0 overflow-hidden">
    <!-- Left Sidebar: SysEx Vault Files -->
    <aside id="sysexSidebar" class="shrink-0 flex flex-col hw-panel rounded-2xl p-2.5 space-y-2 h-64 lg:h-full z-10 select-none w-full lg:w-80 overflow-hidden">
        <div class="flex items-center justify-between pb-1 border-b shrink-0" style="border-color: var(--panel-border);">
            <div class="flex items-center space-x-2">
                <div class="w-6 h-6 rounded-lg bg-indigo-500/20 text-indigo-400 flex items-center justify-center text-xs"><StudioIcon Name="vault" Class="w-3.5 h-3.5" /></div>
                <span class="text-xs font-bold uppercase tracking-wider" style="color: var(--text-hi);">SysEx Vault</span>
                <span id="sysexLibraryCount" class="hw-bay text-[10px] font-mono font-bold px-2 py-0.2 rounded-full text-indigo-400">@filteredDumps.Count dumps</span>
            </div>
            <div class="flex items-center space-x-1">
                <button id="btnImportSysex" type="button" @onclick="() => SoundDesign.ImportSysExWithDialog()" title="Import External .syx File"
                        class="hw-btn w-7 h-7 rounded-lg flex items-center justify-center text-indigo-400"><StudioIcon Name="import" Class="w-3.5 h-3.5" /></button>
                <button id="btnRefreshSysexLibrary" type="button" @onclick="() => SoundDesign.RefreshSysExLibrary()" title="Refresh SysEx Library"
                        class="hw-btn w-7 h-7 rounded-lg flex items-center justify-center" style="color: var(--acc-hi);"><StudioIcon Name="refresh" Class="w-3.5 h-3.5" /></button>
            </div>
        </div>

        <input id="sysexSearchInput"
               type="text"
               value="@_searchQuery"
               @oninput="(e) => _searchQuery = e.Value?.ToString() ?? string.Empty"
               placeholder="Filter bulk dumps..."
               class="hw-input w-full px-3 py-1.5 rounded-xl text-xs" />

        <div id="sysexLibraryList" class="flex-1 min-h-0 overflow-y-auto custom-scrollbar space-y-2 pr-1">
            @if (filteredDumps.Count == 0)
            {
                <div class="p-6 text-center text-slate-500 text-xs space-y-1">
                    <p id="sysexLibraryEmptyMsg">
                        @(is680
                            ? "No SysEx bulk dumps in library. Click \"Listen for Bulk Dump\" and transmit a Voice or Memory dump from your PSS-680."
                            : "No SysEx bulk dumps in library. Click \"Listen for Bulk Dump\" and press MEMORY BULK DUMP on your PSS-790.")
                    </p>
                </div>
            }
            else
            {
                @foreach (var dump in filteredDumps)
                {
                    bool selected = selectedDump != null && string.Equals(selectedDump.FilePath, dump.FilePath, StringComparison.OrdinalIgnoreCase);
                    bool renaming = string.Equals(_renamingPath, dump.FilePath, StringComparison.OrdinalIgnoreCase);
                    <div @onclick="() => _selectedDumpPath = dump.FilePath"
                         class="hw-list-card @(selected ? "is-selected" : "") p-2.5 space-y-1.5 cursor-pointer">
                        @if (renaming)
                        {
                            <div class="flex items-center space-x-1" @onclick:stopPropagation="true">
                                <input type="text" value="@_renameDraft" @oninput="(e) => _renameDraft = e.Value?.ToString() ?? string.Empty"
                                       class="hw-input flex-1 min-w-0 px-2 py-0.5 rounded text-xs font-mono" />
                                <button type="button" @onclick="CommitRename" class="hw-accent-btn px-2 py-0.5 rounded text-[10px] font-bold">OK</button>
                                <button type="button" @onclick="CancelRename" class="hw-close-chip px-1.5 py-0.5 rounded text-[10px]">✕</button>
                            </div>
                        }
                        else
                        {
                            <div class="flex items-start justify-between gap-2">
                                <div class="min-w-0">
                                    <div class="text-xs font-bold truncate font-mono" style="color: var(--text-hi);">@dump.FileName</div>
                                    <div class="text-[10px]" style="color: var(--text-lo);">@dump.DumpType &bull; @dump.FileSizeFormatted &bull; @dump.PacketCount pkt</div>
                                </div>
                            </div>
                        }
                        <div class="flex items-center flex-wrap gap-1" @onclick:stopPropagation="true">
                            <button type="button" @onclick="() => SoundDesign.InspectSysExDump(dump.FilePath)" class="hw-btn px-2 py-0.5 rounded-lg text-[10px] font-semibold text-indigo-400">Inspect</button>
                            <button type="button" @onclick="() => SoundDesign.ExtractSysExToMidi(dump.FilePath)" class="hw-btn px-2 py-0.5 rounded-lg text-[10px] font-semibold text-emerald-400">Extract .mid</button>
                            @if (is680)
                            {
                                <button type="button" @onclick="() => SoundDesign.LoadDrummerPatternFromSysEx(dump.FilePath)" class="hw-btn px-2 py-0.5 rounded-lg text-[10px] font-semibold text-amber-400">03H Grid</button>
                            }
                            <button type="button" @onclick="() => BeginRename(dump)" title="Rename dump" class="hw-btn px-1.5 py-0.5 rounded-lg text-[10px]">Rename</button>
                            <button type="button" @onclick="() => SoundDesign.DeleteSysExDump(dump.FilePath)" title="Delete dump" class="hw-close-chip px-1.5 py-0.5 rounded-lg text-[10px] font-bold">✕</button>
                        </div>
                    </div>
                }
            }
        </div>
    </aside>

    <!-- Right Column: Live Capture + Paced Restore -->
    <div id="deckBulkDumpsRightPane" class="flex-1 min-w-0 h-full flex flex-col space-y-3 overflow-y-auto custom-scrollbar pr-0.5">
        <!-- Section A: Live Capture -->
        <div class="hw-panel p-4 space-y-3">
            <div class="flex items-center justify-between border-b pb-2" style="border-color: var(--panel-border);">
                <div class="flex items-center space-x-2">
                    <span class="w-2.5 h-2.5 rounded-full @(State.IsSysExCapturing ? "bg-emerald-400 animate-ping" : "bg-slate-600")"></span>
                    <h3 class="text-xs font-bold uppercase tracking-wider" style="color: var(--text-hi);">Live SysEx Capture</h3>
                </div>
                <span class="hw-bay px-2 py-0.5 rounded-full text-[10px] font-semibold @(State.IsSysExCapturing ? "text-emerald-400" : "")">
                    @(State.IsSysExCapturing ? "Listening..." : "Idle")
                </span>
            </div>

            <div class="hw-bay p-3.5 rounded-xl text-[11px] space-y-2">
                <div class="flex items-center justify-between pb-1.5 border-b" style="border-color: var(--panel-border);">
                    <div class="font-semibold" style="color: var(--acc-hi);">Memory Bulk Dump Hardware Instructions:</div>
                    <div class="flex items-center space-x-1.5">
                        <div class="hw-bay flex items-center p-0.5 rounded-lg text-[10px]">
                            <button type="button" @onclick='() => State.Mutate(s => s.SysExGuideModelTab = "pss790")'
                                    class="px-2 py-0.5 rounded font-bold @(State.SysExGuideModelTab != "pss680" ? "hw-key-indigo" : "hw-tab-btn")">PSS-790</button>
                            <button type="button" @onclick='() => State.Mutate(s => s.SysExGuideModelTab = "pss680")'
                                    class="px-2 py-0.5 rounded font-bold @(State.SysExGuideModelTab == "pss680" ? "hw-key-amber" : "hw-tab-btn")">PSS-680</button>
                        </div>
                        <button type="button" @onclick="OpenFullGuide" class="hw-btn w-7 h-7 rounded-lg flex items-center justify-center"><StudioIcon Name="guide" Class="w-3.5 h-3.5" /></button>
                    </div>
                </div>

                @if (State.SysExGuideModelTab == "pss680")
                {
                    <ol class="list-decimal list-inside space-y-1 pl-1" style="color: var(--text-mid);">
                        <li>Click <strong class="text-indigo-400">"Listen for Bulk Dump"</strong> below.</li>
                        <li>Hold <kbd class="hw-btn px-1.5 py-0.5 rounded font-bold text-[10px]">MIDI</kbd> on PSS-680 and press <kbd class="hw-btn px-1 py-0.2 rounded">MELODY</kbd>, <kbd class="hw-btn px-1 py-0.2 rounded">CHORD</kbd>, <kbd class="hw-btn px-1 py-0.2 rounded">CUSTOM DRUMMER</kbd>, or <kbd class="hw-btn px-1 py-0.2 rounded">RECORD</kbd>.</li>
                        <li>App validates Yamaha checksums and auto-saves `.syx` in your Vault!</li>
                    </ol>
                }
                else
                {
                    <ol class="list-decimal list-inside space-y-1 pl-1" style="color: var(--text-mid);">
                        <li>Click <strong class="text-indigo-400">"Listen for Bulk Dump"</strong> below.</li>
                        <li>Press <kbd class="hw-btn px-1.5 py-0.5 rounded font-bold text-[10px]">MEMORY BULK DUMP</kbd> twice on PSS-790 (display shows <code class="text-amber-500 font-bold">b-8</code>).</li>
                        <li>Auto-saves full 8-track Song Memory, styles &amp; voices as a `.syx` file!</li>
                    </ol>
                }
            </div>

            <div class="grid grid-cols-3 gap-2 text-center">
                <div class="hw-vfd p-2 rounded-xl">
                    <span class="text-[9px] uppercase font-bold opacity-75 block">Packets</span>
                    <span class="text-base font-extrabold font-mono">@State.SysExCapturePackets</span>
                </div>
                <div class="hw-vfd p-2 rounded-xl">
                    <span class="text-[9px] uppercase font-bold opacity-75 block">Bytes In</span>
                    <span class="text-base font-extrabold font-mono">@SysExManager.FormatBytes(State.SysExCaptureBytes)</span>
                </div>
                <div class="hw-vfd p-2 rounded-xl">
                    <span class="text-[9px] uppercase font-bold opacity-75 block">Status</span>
                    <span class="text-[11px] font-semibold text-emerald-400 truncate block mt-0.5">@State.SysExCaptureStatus</span>
                </div>
            </div>

            <div class="flex items-center space-x-2">
                <button id="btnStartSysexCapture" type="button"
                        disabled="@State.IsSysExCapturing"
                        @onclick="() => SoundDesign.StartSysExCapture()"
                        class="hw-key-indigo flex-1 py-2.5 rounded-xl disabled:opacity-40 font-bold text-xs">
                    🎙️ @(State.IsSysExCapturing ? "Listening for Hardware Dump..." : "Listen for Bulk Dump")
                </button>
                @if (State.IsSysExCapturing)
                {
                    <button id="btnStopSysexCapture" type="button" @onclick="() => SoundDesign.StopSysExCapture()"
                            class="hw-key-rose px-4 py-2.5 rounded-xl font-bold text-xs">Stop</button>
                }
            </div>
        </div>

        <!-- Section B: Paced Restore Deck -->
        <div class="hw-panel p-4 space-y-3">
            <div class="flex items-center justify-between border-b pb-2" style="border-color: var(--panel-border);">
                <h3 class="text-xs font-bold uppercase tracking-wider" style="color: var(--text-hi);">Restore / Transmit to Keyboard</h3>
                <span class="text-[10px] font-mono" style="color: var(--text-lo);">Buffer Protected</span>
            </div>

            <div class="hw-bay p-3 rounded-xl space-y-1">
                <div class="text-[10px] uppercase font-bold" style="color: var(--text-lo);">Selected Dump:</div>
                <div class="text-xs font-bold truncate font-mono" style="color: var(--text-hi);">@(selectedDump?.FileName ?? "No dump selected")</div>
                <div class="flex items-center space-x-3 text-[11px]" style="color: var(--text-mid);">
                    <span>Size: <strong class="font-mono" style="color: var(--text-hi);">@(selectedDump?.FileSizeFormatted ?? "--")</strong></span>
                    <span>Packets: <strong class="font-mono" style="color: var(--text-hi);">@(selectedDump?.PacketCount.ToString() ?? "--")</strong></span>
                    <span>Type: <strong class="text-indigo-400">@(selectedDump?.DumpType ?? "--")</strong></span>
                </div>
            </div>

            <div class="hw-bay flex items-center justify-between p-2.5 rounded-xl text-xs">
                <div>
                    <div class="font-semibold" style="color: var(--text-hi);">Paced Packet Delay</div>
                    <div class="text-[10px]" style="color: var(--text-lo);">@(is680 ? "Prevents PSS-680 serial buffer overflow" : "Prevents PSS-790 <bu full> overflow")</div>
                </div>
                <select value="@State.SysExTransmitDelayMs"
                        @onchange="(e) => { if (int.TryParse(e.Value?.ToString(), out int ms)) State.Mutate(s => s.SysExTransmitDelayMs = ms); }"
                        class="hw-select text-xs font-semibold px-2.5 py-1 rounded-lg cursor-pointer">
                    <option value="15">15 ms (Fast)</option>
                    <option value="25">25 ms (Safe)</option>
                    <option value="30">30 ms (Recommended)</option>
                    <option value="50">50 ms (Conservative)</option>
                    <option value="100">100 ms (Slow)</option>
                </select>
            </div>

            @if (State.IsSysExTransmitting)
            {
                <div class="space-y-1.5">
                    <div class="flex items-center justify-between text-xs" style="color: var(--text-mid);">
                        <span class="truncate font-mono">@State.SysExTransmitStatus (@State.SysExTransmitPacketIndex/@State.SysExTransmitPacketTotal)</span>
                        <span class="font-mono font-bold" style="color: var(--acc-hi);">@State.SysExTransmitProgress%</span>
                    </div>
                    <div class="w-full hw-bay rounded-full h-2.5 overflow-hidden">
                        <div class="bg-gradient-to-r from-indigo-500 to-cyan-500 h-full transition-all duration-150" style="width: @(State.SysExTransmitProgress)%;"></div>
                    </div>
                </div>
            }

            <div class="flex items-center space-x-2">
                <button id="btnTransmitSysex" type="button"
                        disabled="@(selectedDump == null || State.IsSysExTransmitting)"
                        @onclick="() => { if (selectedDump != null) _ = SoundDesign.TransmitSysExDumpAsync(selectedDump.FilePath); }"
                        class="hw-key-amber flex-1 py-2.5 rounded-xl disabled:opacity-40 font-bold text-xs">
                    @(is680 ? "Transmit to PSS-680" : "Transmit to PSS-790")
                </button>
                @if (State.IsSysExTransmitting)
                {
                    <button type="button" @onclick="() => SoundDesign.CancelSysExTransmit()"
                            class="hw-key-rose px-4 py-2.5 rounded-xl font-bold text-xs">Cancel</button>
                }
            </div>
        </div>
    </div>
</div>

@code {
    protected override StateScope SubscribedScopes => StateScope.SoundDesign | StateScope.Shell;

    private string _searchQuery = string.Empty;
    private string? _selectedDumpPath;
    private string? _renamingPath;
    private string _renameDraft = string.Empty;

    private void BeginRename(SysExDumpInfo dump)
    {
        _renamingPath = dump.FilePath;
        _renameDraft = Path.GetFileNameWithoutExtension(dump.FileName);
    }

    private void CommitRename()
    {
        if (!string.IsNullOrEmpty(_renamingPath) && !string.IsNullOrWhiteSpace(_renameDraft))
        {
            SoundDesign.RenameSysExDump(_renamingPath, _renameDraft.Trim());
        }
        CancelRename();
    }

    private void CancelRename()
    {
        _renamingPath = null;
        _renameDraft = string.Empty;
    }

    private void OpenFullGuide()
    {
        State.Mutate(s =>
        {
            s.ModalGuideModel = State.SysExGuideModelTab;
            s.ModalGuideMethod = "sysex";
            s.ShowHardwareGuideModal = true;
        });
    }
}
