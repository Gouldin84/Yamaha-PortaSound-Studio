@inherits StudioComponentBase
@inject SoundDesignService SoundDesign

@{
    bool is680 = string.Equals(State.ActiveModel, "pss680", StringComparison.OrdinalIgnoreCase);
    string mode = State.SysExViewMode;
    if (mode != "drums" && mode != "vault")
    {
        mode = is680 ? "fm" : "vector";
    }
}

<section class="w-full h-full flex flex-col space-y-2.5 min-h-0 overflow-hidden">
    <!-- Top Sub-Header Pill Bar -->
    <div class="hw-panel px-3 py-2 flex flex-wrap items-center justify-between gap-2 shrink-0">
        <div class="min-w-0">
            <h2 id="sysexVaultHeaderTitle" class="text-xs sm:text-sm font-bold truncate" style="color: var(--text-hi);">
                @(is680 ? "Yamaha PSS-680 FM Sound Designer & SysEx Vault" : "Yamaha PSS-790 Vector Synthesizer & SysEx Vault")
            </h2>
            <p id="sysexVaultHeaderSubtitle" class="text-[10px] font-mono truncate" style="color: var(--text-lo);">
                @(is680
                    ? "Design 2-op FM voices, 18 hidden parameters, 03H drum patterns & memory backups"
                    : "Real-time 2D 4-voice vector synthesis, LFO orbit automation, Chart 1 percussion & backups")
            </p>
        </div>

        <div class="flex items-center flex-wrap gap-2 shrink-0">
            <div class="hw-bay flex items-center rounded-xl p-1 space-x-1">
                <button id="btnSysexViewDesigner"
                        type="button"
                        @onclick='() => SetViewMode(is680 ? "fm" : "vector")'
                        class="hw-tab-btn px-2.5 sm:px-3 py-1 rounded-lg text-xs font-bold flex items-center space-x-1.5 @(mode is "fm" or "vector" ? "active" : "")">
                    <StudioIcon Name="@(is680 ? "synth" : "vector")" Class="w-3.5 h-3.5" />
                    <span id="sysexDesignerPillLabel">@(is680 ? "FM Sound Designer" : "Vector Synthesizer")</span>
                </button>
                <button id="btnSysexViewDrums"
                        type="button"
                        @onclick='() => SetViewMode("drums")'
                        class="hw-tab-btn px-2.5 sm:px-3 py-1 rounded-lg text-xs font-bold flex items-center space-x-1.5 @(mode == "drums" ? "active" : "")">
                    <StudioIcon Name="drums" Class="w-3.5 h-3.5" />
                    <span>@(is680 ? "Drummer & Pads" : "Drum Pads")</span>
                </button>
                <button id="btnSysexViewDumps"
                        type="button"
                        @onclick='() => SetViewMode("vault")'
                        class="hw-tab-btn px-2.5 sm:px-3 py-1 rounded-lg text-xs font-bold flex items-center space-x-1.5 @(mode == "vault" ? "active" : "")">
                    <StudioIcon Name="vault" Class="w-3.5 h-3.5" />
                    <span>SysEx Bulk Vault</span>
                </button>
            </div>

            <button type="button" @onclick='() => SoundDesign.SendQuickSysEx("all_reset")' title="Send All Notes Off & Reset Controllers across 16 channels"
                    class="px-2.5 py-1 rounded-xl bg-rose-950/60 hover:bg-rose-700 text-rose-300 hover:text-white border border-rose-700/60 text-xs font-bold flex items-center space-x-1 transition active:scale-95">
                <StudioIcon Name="bolt" Class="w-3.5 h-3.5" />
                <span>Panic Reset</span>
            </button>
            <button type="button" @onclick="() => SoundDesign.OpenSysExFolder()" title="Open SysEx Vault Folder"
                    class="hw-btn px-2.5 py-1 rounded-xl text-amber-400 text-xs font-semibold flex items-center space-x-1">
                <StudioIcon Name="folder" Class="w-3.5 h-3.5" />
                <span>Vault</span>
            </button>
        </div>
    </div>

    <!-- Active Sub-Deck with Transition Choreography -->
    <div class="flex-1 min-h-0 overflow-hidden">
        @if (mode == "drums")
        {
            <div @key="@("drums")" class="workspace-enter w-full h-full min-h-0">
                <DrumPadsDeck />
            </div>
        }
        else if (mode == "vault")
        {
            <div @key="@("vault")" class="workspace-enter w-full h-full min-h-0">
                <SysExVaultPanel />
            </div>
        }
        else if (is680)
        {
            <div @key="@("fm")" class="workspace-enter w-full h-full min-h-0">
                <FmVoiceDesigner />
            </div>
        }
        else
        {
            <div @key="@("vector")" class="workspace-enter w-full h-full min-h-0">
                <VectorSynthPad />
            </div>
        }
    </div>
</section>

@code {
    protected override StateScope SubscribedScopes => StateScope.SoundDesign | StateScope.Shell;

    private void SetViewMode(string mode) => State.Mutate(s => s.SysExViewMode = mode, StateScope.SoundDesign);
}
