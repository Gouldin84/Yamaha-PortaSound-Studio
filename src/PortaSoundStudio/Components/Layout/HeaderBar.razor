@inherits StudioComponentBase
@inject HardwareDeviceService Devices
@inject LibraryService Library
@inject PlaybackCoordinator Playback
@inject IJSRuntime JS

<header class="hw-panel hw-header-bar shrink-0 z-40 px-2.5 sm:px-3 py-1.5 flex items-center justify-between gap-2 max-w-full overflow-visible">
    <!-- Left: Hardware Model Switcher & Segmented Workspace Navigation -->
    <div class="flex items-center space-x-2 sm:space-x-3 min-w-0">
        <!-- Synthesizer Model Switcher -->
        <div class="relative shrink-0" id="modelSelectorContainer">
            <button id="modelSelectorBtn"
                    type="button"
                    @onclick="ToggleModelMenu"
                    title="Switch Synthesizer Model: Select Yamaha PSS-790 (AWM) or PSS-680 (FM)"
                    class="hw-bay flex items-center space-x-2 px-2 py-1 rounded-xl hover:brightness-110 transition-all duration-200 group cursor-pointer">
                <div class="relative shrink-0">
                    <img id="activeModelIcon"
                         src="@(IsPss680 ? "images/pss680_icon.png" : "images/app_icon.png")"
                         alt="Model Icon"
                         class="w-7 h-7 rounded-lg shadow-md object-cover border transition-transform group-hover:scale-105"
                         style="border-color: var(--acc-glow); box-shadow: 0 0 12px -2px var(--acc-glow);" />
                </div>
                <div class="text-left leading-tight">
                    <div class="flex items-center space-x-1.5">
                        <span id="activeModelTitle" class="text-xs sm:text-sm font-bold tracking-tight whitespace-nowrap" style="color: var(--text-hi);">
                            @(IsPss680 ? "PSS-680 Studio" : "PSS-790 Studio")
                        </span>
                        <span id="activeModelBadge"
                              class="px-1.5 py-0.2 text-[9px] font-bold uppercase tracking-wider rounded-full hidden sm:inline-block"
                              style="background: var(--acc-soft); color: var(--acc-hi); border: 1px solid var(--acc-glow);">
                            @(IsPss680 ? "2-Op FM" : "AWM Vector")
                        </span>
                    </div>
                    <p id="activeModelSubtitle" class="hidden xl:block text-[9px] font-mono" style="color: var(--text-lo);">PortaSound Workstation v3.1.1</p>
                </div>
                <svg id="modelDropdownChevron"
                     class="w-3.5 h-3.5 transition-transform duration-200 ml-0.5 shrink-0 @(ShowModelMenu ? "rotate-180" : "")"
                     style="color: var(--text-mid);"
                     fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
            </button>

            @if (ShowModelMenu)
            {
                <div id="modelDropdownMenu"
                     class="dropdown-spring hw-panel absolute left-0 top-full mt-2 w-80 rounded-2xl p-2 z-50"
                     role="menu">
                    <div class="px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider border-b mb-1.5" style="color: var(--text-lo); border-color: var(--panel-border);">
                        Target Synthesizer Hardware
                    </div>

                    <button type="button"
                            @onclick='() => SelectModel("pss790")'
                            class="model-option-btn hw-list-card @(!IsPss680 ? "is-selected" : "") w-full flex items-center justify-between p-2.5 text-left mb-1.5 cursor-pointer">
                        <div class="flex items-center space-x-2.5 min-w-0">
                            <img src="images/app_icon.png" alt="PSS-790" class="w-8 h-8 rounded-lg border border-cyan-500/40 shrink-0" />
                            <div class="min-w-0">
                                <div class="text-xs font-bold flex items-center space-x-1.5" style="color: var(--text-hi);">
                                    <span>Yamaha PSS-790</span>
                                    <span class="px-1.5 py-0.2 text-[8px] font-bold rounded bg-cyan-950 text-cyan-300 border border-cyan-800">28-Voice AWM</span>
                                </div>
                                <div class="text-[10px] truncate" style="color: var(--text-mid);">AWM PCM + 2D Vector Joystick Synth</div>
                            </div>
                        </div>
                        @if (!IsPss680)
                        {
                            <StudioIcon Name="check" Class="w-4 h-4 text-cyan-400 shrink-0 ml-1" />
                        }
                    </button>

                    <button type="button"
                            @onclick='() => SelectModel("pss680")'
                            class="model-option-btn hw-list-card @(IsPss680 ? "is-selected" : "") w-full flex items-center justify-between p-2.5 text-left cursor-pointer">
                        <div class="flex items-center space-x-2.5 min-w-0">
                            <img src="images/pss680_icon.png" alt="PSS-680" class="w-8 h-8 rounded-lg border border-amber-500/40 shrink-0" />
                            <div class="min-w-0">
                                <div class="text-xs font-bold flex items-center space-x-1.5" style="color: var(--text-hi);">
                                    <span>Yamaha PSS-680 / 480 / 780</span>
                                    <span class="px-1.5 py-0.2 text-[8px] font-bold rounded bg-amber-950 text-amber-300 border border-amber-800">12-Voice FM</span>
                                </div>
                                <div class="text-[10px] truncate" style="color: var(--text-mid);">2-Op FM Synth &bull; Custom Drummer &bull; SysEx</div>
                            </div>
                        </div>
                        @if (IsPss680)
                        {
                            <StudioIcon Name="check" Class="w-4 h-4 text-amber-400 shrink-0 ml-1" />
                        }
                    </button>
                </div>
            }
        </div>

        <!-- Hardware Segmented Navigation Rail -->
        <nav class="hw-bay rounded-xl p-1 flex items-center space-x-1 shrink-0">
            <button id="tabBtnPlayer"
                    type="button"
                    @onclick="() => SetTab(StudioTab.Player)"
                    title="Player Workspace (1): Load, preview, and play back MIDI files with real-time remapping"
                    class="hw-tab-btn tab-btn flex items-center space-x-1.5 px-2.5 sm:px-3 py-1 rounded-lg text-xs font-bold @(State.ActiveTab == StudioTab.Player ? "active" : "")">
                <StudioIcon Name="player" Class="w-3.5 h-3.5 shrink-0" />
                <span class="hidden sm:inline">Player</span>
            </button>

            <button id="tabBtnRecorder"
                    type="button"
                    @onclick="() => SetTab(StudioTab.Recorder)"
                    title="Studio Recorder Workspace (2): Record live MIDI keyboard performances with metronome"
                    class="hw-tab-btn tab-btn flex items-center space-x-1.5 px-2.5 sm:px-3 py-1 rounded-lg text-xs font-bold @(State.ActiveTab == StudioTab.Recorder ? "active" : "")">
                <span class="w-2 h-2 rounded-full @(State.RecorderState is RecorderState.Recording or RecorderState.CountIn ? "bg-white animate-ping" : "bg-rose-500")"></span>
                <span class="hidden sm:inline">Recorder</span>
                @if (State.RecorderState is RecorderState.Recording or RecorderState.CountIn)
                {
                    <span id="recordingPill" class="px-1.5 py-0.2 bg-rose-500/25 text-rose-200 text-[9px] font-bold rounded-full border border-rose-400/50 animate-pulse">REC</span>
                }
            </button>

            <button id="tabBtnSysex"
                    type="button"
                    @onclick="() => SetTab(StudioTab.SysEx)"
                    title="Sound Designer & SysEx Vault (3): FM Designer, Vector Synth, Drum Pads & Bulk Backups"
                    class="hw-tab-btn tab-btn flex items-center space-x-1.5 px-2.5 sm:px-3 py-1 rounded-lg text-xs font-bold @(State.ActiveTab == StudioTab.SysEx ? "active" : "")">
                <StudioIcon Name="synth" Class="w-3.5 h-3.5 shrink-0" />
                <span class="hidden sm:inline">@(IsPss680 ? "FM & SysEx" : "Vector & SysEx")</span>
            </button>
        </nav>
    </div>

    <!-- Right: MIDI Output Bay & Hardware Utilities -->
    <div class="flex items-center space-x-1.5 shrink-0">
        <!-- Output MIDI Port Bay -->
        <div class="hw-bay flex items-center space-x-1.5 px-2.5 py-1 rounded-xl">
            <span id="outputStatusDot"
                  title="Output Status"
                  class="w-2 h-2 rounded-full shrink-0 @(string.IsNullOrEmpty(State.SelectedOutputDevice) ? "bg-rose-500" : "bg-emerald-400 animate-pulse-slow")"
                  style="@(string.IsNullOrEmpty(State.SelectedOutputDevice) ? "" : "box-shadow: 0 0 8px #10b981;")"></span>
            <select id="deviceSelect"
                    value="@(State.SelectedOutputDevice ?? "")"
                    @onchange="OnOutputDeviceChanged"
                    title="MIDI Output Device: Select hardware interface or MS GS Wavetable Synth"
                    class="bg-transparent text-[11px] font-semibold focus:outline-none cursor-pointer max-w-[95px] sm:max-w-[130px] 2xl:max-w-[180px] truncate"
                    style="color: var(--text-hi);">
                @if (State.OutputDevices.Count == 0)
                {
                    <option value="">No MIDI outputs</option>
                }
                else
                {
                    <option value="">-- Select Output --</option>
                    @foreach (var dev in State.OutputDevices)
                    {
                        <option value="@dev">@dev</option>
                    }
                }
            </select>
            <button id="btnRefreshDevices"
                    type="button"
                    @onclick="() => Devices.TriggerRescan(0)"
                    title="Rescan MIDI Devices (Hot-Swap)"
                    class="transition p-0.5 active:scale-90 hover:brightness-125"
                    style="color: var(--acc-hi);">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
            </button>
        </div>

        @if (State.ActiveTab == StudioTab.Player)
        {
            <button id="btnToggleSidebar"
                    type="button"
                    @onclick="() => State.Mutate(s => s.IsSidebarCollapsed = !s.IsSidebarCollapsed)"
                    title="Toggle Library Sidebar (Ctrl+B)"
                    class="hw-btn flex items-center space-x-1 px-2 py-1 rounded-xl text-xs font-semibold shrink-0">
                <svg class="w-3.5 h-3.5 shrink-0" style="color: var(--acc-hi);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
                </svg>
                <span class="hidden 2xl:inline">Library</span>
            </button>
        }

        <button id="btnBrowse"
                type="button"
                @onclick="() => Playback.BrowseAndLoadMidiWithDialog()"
                title="Load MIDI File: Open Windows file picker"
                class="hw-btn flex items-center space-x-1 px-2 py-1 rounded-xl text-xs font-semibold shrink-0">
            <svg class="w-3.5 h-3.5 shrink-0" style="color: var(--acc-hi);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
            </svg>
            <span class="hidden xl:inline">Load</span>
        </button>

        <button id="btnSaveRemapped"
                type="button"
                @onclick="() => Playback.SaveRemappedWithDialog()"
                disabled="@(State.LoadedSong == null || !State.LoadedSong.CanSaveRemapped)"
                title="Export Remapped MIDI for target hardware"
                class="hw-accent-btn flex items-center space-x-1.5 px-2.5 py-1 rounded-xl disabled:opacity-40 disabled:cursor-not-allowed text-xs font-bold shrink-0">
            <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" />
            </svg>
            <span class="hidden sm:inline">Export</span>
        </button>

        <button id="btnToggleHandheldMode"
                type="button"
                @onclick="ToggleHandheldMode"
                title="Toggle Handheld Touch Mode (T)"
                class="flex items-center space-x-1 px-2 py-1 rounded-xl text-xs font-semibold shrink-0 transition @(State.HandheldMode ? "hw-accent-btn" : "hw-btn")">
            <StudioIcon Name="touch" Class="w-3.5 h-3.5" />
            <span id="handheldModeText" class="hidden 2xl:inline text-[11px]">Touch</span>
        </button>

        <button id="btnThemeToggle"
                type="button"
                @onclick="ToggleTheme"
                title="Toggle Obsidian Dark / Anodized Silver Light"
                class="hw-btn flex items-center space-x-1 px-2 py-1 rounded-xl text-xs font-semibold shrink-0">
            <span id="themeToggleIcon" class="flex items-center">
                <StudioIcon Name="@(State.IsDarkTheme ? "sun" : "moon")" Class="w-3.5 h-3.5" />
            </span>
            <span id="themeToggleText" class="hidden 2xl:inline text-[11px]">@(State.IsDarkTheme ? "Silver" : "Obsidian")</span>
        </button>

        <!-- Wide Desktop Utilities -->
        <button id="btnOpenFolder" type="button" @onclick="() => Library.OpenExplorer()"
                class="hw-btn hidden 2xl:flex items-center space-x-1 px-2 py-1 rounded-xl text-xs font-semibold shrink-0" title="Open MIDI Folder">
            <StudioIcon Name="folder" Class="w-3.5 h-3.5 text-amber-400" /><span>Folder</span>
        </button>
        <button id="btnOpenBatch" type="button" @onclick="() => State.Mutate(s => s.ShowBatchModal = true)"
                class="hw-btn hidden 2xl:flex items-center space-x-1 px-2 py-1 rounded-xl text-xs font-semibold shrink-0" title="Batch Remapper">
            <StudioIcon Name="bolt" Class="w-3.5 h-3.5 text-amber-400" /><span>Batch</span>
        </button>
        <button id="btnShortcuts" type="button" @onclick="() => State.Mutate(s => s.ShowShortcutsModal = true)"
                class="hw-btn hidden 2xl:flex items-center space-x-1 px-2 py-1 rounded-xl text-xs font-semibold shrink-0" title="Keyboard Shortcuts (? / F1)">
            <StudioIcon Name="keyboard" Class="w-3.5 h-3.5" /><span>Hotkeys</span>
        </button>
        <button id="btnAbout" type="button" @onclick="() => State.Mutate(s => s.ShowAboutModal = true)"
                class="hw-btn hidden 2xl:flex items-center space-x-1 px-2 py-1 rounded-xl text-xs font-semibold shrink-0" title="About & Legal Notices">
            <StudioIcon Name="info" Class="w-3.5 h-3.5 text-cyan-400" /><span>About</span>
        </button>
        <button id="btnSettings" type="button" @onclick="() => State.Mutate(s => s.ShowSettingsModal = true)"
                class="hw-btn hidden 2xl:flex items-center space-x-1 px-2 py-1 rounded-xl text-xs font-semibold shrink-0" title="Studio Settings">
            <StudioIcon Name="settings" Class="w-3.5 h-3.5" /><span>Settings</span>
        </button>

        <!-- Compact More Tools Dropdown -->
        <div class="relative shrink-0 2xl:hidden" id="moreToolsContainer">
            <button id="btnMoreTools"
                    type="button"
                    @onclick="ToggleMoreMenu"
                    title="More Studio Tools & Options"
                    class="hw-btn flex items-center justify-center w-7 h-7 sm:w-8 sm:h-8 rounded-xl cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z" />
                </svg>
            </button>

            @if (ShowMoreMenu)
            {
                <div id="moreToolsDropdownMenu"
                     class="dropdown-spring hw-panel absolute right-0 top-full mt-1.5 w-60 rounded-2xl p-1.5 z-50"
                     role="menu">
                    <div class="px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider border-b mb-1 flex items-center justify-between" style="color: var(--text-lo); border-color: var(--panel-border);">
                        <span>Studio Tools</span>
                        <span class="font-mono text-[9px]" style="color: var(--acc);">Options</span>
                    </div>
                    <button type="button" @onclick="() => { CloseMenus(); Library.OpenExplorer(); }" class="w-full flex items-center space-x-2.5 px-2.5 py-1.5 rounded-xl hover:bg-slate-800/40 text-xs font-medium transition text-left cursor-pointer">
                        <StudioIcon Name="folder" Class="w-3.5 h-3.5 text-amber-400" /><span>Open Music Folder</span>
                    </button>
                    <button type="button" @onclick="() => { CloseMenus(); State.Mutate(s => s.ShowBatchModal = true); }" class="w-full flex items-center space-x-2.5 px-2.5 py-1.5 rounded-xl hover:bg-slate-800/40 text-xs font-medium transition text-left cursor-pointer">
                        <StudioIcon Name="bolt" Class="w-3.5 h-3.5 text-amber-400" /><span>Batch Remapper</span>
                    </button>
                    <button type="button" @onclick="() => { CloseMenus(); State.Mutate(s => s.ShowShortcutsModal = true); }" class="w-full flex items-center space-x-2.5 px-2.5 py-1.5 rounded-xl hover:bg-slate-800/40 text-xs font-medium transition text-left cursor-pointer">
                        <StudioIcon Name="keyboard" Class="w-3.5 h-3.5 text-cyan-400" /><span>Hotkeys &amp; Controller (? / F1)</span>
                    </button>
                    <button type="button" @onclick="() => { CloseMenus(); OpenHardwareGuide(); }" class="w-full flex items-center space-x-2.5 px-2.5 py-1.5 rounded-xl hover:bg-slate-800/40 text-xs font-medium transition text-left cursor-pointer">
                        <StudioIcon Name="book" Class="w-3.5 h-3.5 text-emerald-400" /><span>Hardware Capture Guide</span>
                    </button>
                    <button type="button" @onclick="() => { CloseMenus(); State.Mutate(s => s.ShowAboutModal = true); }" class="w-full flex items-center space-x-2.5 px-2.5 py-1.5 rounded-xl hover:bg-slate-800/40 text-xs font-medium transition text-left cursor-pointer">
                        <StudioIcon Name="info" Class="w-3.5 h-3.5 text-cyan-400" /><span>About &amp; Legal Notices</span>
                    </button>
                    <button type="button" @onclick="() => { CloseMenus(); State.Mutate(s => s.ShowSettingsModal = true); }" class="w-full flex items-center space-x-2.5 px-2.5 py-1.5 rounded-xl hover:bg-slate-800/40 text-xs font-medium transition text-left cursor-pointer">
                        <StudioIcon Name="settings" Class="w-3.5 h-3.5 text-slate-400" /><span>Library Storage Settings</span>
                    </button>
                </div>
            }
        </div>
    </div>
</header>

@code {
    protected override StateScope SubscribedScopes => StateScope.Shell | StateScope.Library;

    private bool ShowModelMenu => State.ActiveHeaderMenu == "model";
    private bool ShowMoreMenu => State.ActiveHeaderMenu == "more";
    private bool IsPss680 => string.Equals(State.ActiveModel, "pss680", StringComparison.OrdinalIgnoreCase);

    private void ToggleModelMenu() =>
        State.Mutate(s => s.ActiveHeaderMenu = s.ActiveHeaderMenu == "model" ? null : "model", StateScope.Shell);

    private void ToggleMoreMenu() =>
        State.Mutate(s => s.ActiveHeaderMenu = s.ActiveHeaderMenu == "more" ? null : "more", StateScope.Shell);

    private void CloseMenus() =>
        State.Mutate(s => s.ActiveHeaderMenu = null, StateScope.Shell);

    private async Task SelectModel(string model)
    {
        CloseMenus();
        Playback.SetActiveModel(model);
        try
        {
            await JS.InvokeVoidAsync("studioInterop.applyBodyPreferences", State.IsDarkTheme, State.HandheldMode, model);
        }
        catch { }
    }

    private void SetTab(StudioTab tab) =>
        State.Mutate(s =>
        {
            s.ActiveHeaderMenu = null;
            s.ActiveTab = tab;
        }, StateScope.Shell);

    private void OnOutputDeviceChanged(ChangeEventArgs e)
    {
        Devices.SelectOutputDevice(e.Value?.ToString());
    }

    private async Task ToggleTheme()
    {
        State.Mutate(s => s.IsDarkTheme = !s.IsDarkTheme);
        await JS.InvokeVoidAsync("studioInterop.applyBodyPreferences", State.IsDarkTheme, State.HandheldMode, State.ActiveModel);
    }

    private async Task ToggleHandheldMode()
    {
        State.Mutate(s => s.HandheldMode = !s.HandheldMode);
        await JS.InvokeVoidAsync("studioInterop.applyBodyPreferences", State.IsDarkTheme, State.HandheldMode, State.ActiveModel);
    }

    private void OpenHardwareGuide()
    {
        State.Mutate(s =>
        {
            s.ModalGuideModel = State.ActiveModel;
            s.ModalGuideMethod = State.ActiveTab == StudioTab.SysEx ? "sysex" : "midi";
            s.ShowHardwareGuideModal = true;
        });
    }
}
