@inherits StudioComponentBase

<div class="studio-chassis h-screen w-screen flex flex-col overflow-hidden relative" style="color: var(--text-hi);">
    <!-- Model-Reactive Ambient Subsurface Lighting for Frosted 3D Acrylic Panels -->
    <div class="ambient-orb ambient-orb-primary ambient-orb-1"></div>
    <div class="ambient-orb ambient-orb-secondary ambient-orb-2"></div>
    <div class="ambient-orb ambient-orb-accent ambient-orb-3"></div>

    <HeaderBar />

    @if (!string.IsNullOrEmpty(State.ActiveHeaderMenu))
    {
        <div class="fixed inset-0 z-30" @onclick="() => State.Mutate(s => s.ActiveHeaderMenu = null, StateScope.Shell)"></div>
    }

    <main class="flex-1 min-h-0 flex p-2 sm:p-3 w-full overflow-hidden relative z-10">
        @switch (State.ActiveTab)
        {
            case StudioTab.Player:
                <div @key="StudioTab.Player" class="workspace-enter w-full h-full min-h-0 flex">
                    <PlayerWorkspace />
                </div>
                break;
            case StudioTab.Recorder:
                <div @key="StudioTab.Recorder" class="workspace-enter w-full h-full min-h-0 flex">
                    <RecorderWorkspace />
                </div>
                break;
            case StudioTab.SysEx:
                <div @key="StudioTab.SysEx" class="workspace-enter w-full h-full min-h-0 flex">
                    <SoundDesignWorkspace />
                </div>
                break;
        }
    </main>

    <ModalsContainer />
</div>

@code {
    protected override StateScope SubscribedScopes => StateScope.Shell;
}
