@inherits StudioComponentBase
@inject PlaybackCoordinator Playback
@inject SoundDesignService SoundDesign
@inject IJSRuntime JS

@{
    bool is680 = string.Equals(State.ActiveModel, "pss680", StringComparison.OrdinalIgnoreCase);
    var channels = State.LoadedSong?.Channels ?? DefaultEmptyChannels();
    var voices = State.ActiveVoices;
}

<section class="hw-panel p-2.5 space-y-2">
    <div class="flex items-center justify-between flex-wrap gap-1.5">
        <div class="flex items-center space-x-2">
            <h3 class="text-[11px] font-bold uppercase tracking-wider" style="color: var(--text-hi);">16-Channel Console Rack</h3>
            <span id="mixerSubtitle" class="hidden sm:inline text-[10px] font-mono" style="color: var(--text-lo);">
                @(is680 ? "Live FM & PCM Overrides • Ch 16 Hand Percussion" : "Live Voice Overrides (Chart 2) • Ch 16 Fixed Rhythm")
            </span>
        </div>

        <div class="flex items-center flex-wrap gap-1">
            @if (!is680)
            {
                <div id="vectorQuadControls" class="hw-bay flex items-center space-x-1.5 rounded-xl px-2 py-0.5">
                    <StudioIcon Name="vector" Class="w-3 h-3 text-indigo-400" />
                    <span class="text-[10px] font-bold text-indigo-400">Vector Quad (Ch 1-4):</span>
                    <button id="btnToggleVectorQuad"
                            type="button"
                            @onclick="ToggleVectorQuad"
                            class="px-2 py-0.5 rounded-lg text-[10px] font-bold transition cursor-pointer @(State.VectorQuadPlaybackEnabled ? "hw-accent-btn" : "hw-btn")">
                        @(State.VectorQuadPlaybackEnabled ? "ON" : "OFF")
                    </button>
                    @if (State.VectorQuadPlaybackEnabled)
                    {
                        <select id="selMixerVectorPreset"
                                value="@State.SelectedMixerVectorPreset"
                                @onchange="OnMixerVectorPresetChanged"
                                class="bg-slate-950 border border-slate-700 rounded-lg px-1.5 py-0.5 text-[10px] text-indigo-200 focus:outline-none cursor-pointer">
                            <option value="current">Current Channel 1-4 Voices</option>
                            @foreach (var vp in State.VectorPresetLibrary)
                            {
                                <option value="@vp.FilePath">@vp.Name</option>
                            }
                        </select>
                    }
                </div>
            }

            <button id="btnSoloDrums" type="button" @onclick="SoloDrums" class="hw-btn flex items-center space-x-1 px-2 py-0.5 rounded-xl text-[10px] font-semibold text-amber-400">
                <StudioIcon Name="drums" Class="w-3 h-3" /><span>Solo Drums</span>
            </button>
            <button id="btnMuteMelodic" type="button" @onclick="MuteMelodic" class="hw-btn px-2 py-0.5 rounded-xl text-[10px] font-medium">Mute Melodic</button>
            <button id="btnUnmuteAll" type="button" @onclick="UnmuteAll" class="hw-btn px-2 py-0.5 rounded-xl text-[10px] font-medium">Unmute All</button>
            <button id="btnResetAllFaders" type="button" @onclick="ResetFaders" class="hw-btn px-2 py-0.5 rounded-xl text-[10px] font-medium">Reset Faders</button>
            <button id="btnResetOverrides" type="button" @onclick="() => Playback.ResetAllVoiceOverrides()" class="hw-btn flex items-center space-x-1 px-2 py-0.5 rounded-xl text-[10px] font-medium">
                <StudioIcon Name="reset" Class="w-3 h-3" /><span>Reset Voices</span>
            </button>
        </div>
    </div>

    <!-- Dual-Row 2x8 Vertical Console Strips (Fits cleanly at 1280x720 / ROG Ally 150% DPI) -->
    <div id="mixerGrid" class="mixer-grid-responsive">
        @foreach (var ch in channels)
        {
            bool active = State.ChannelActive[ch.Channel];
            byte vel = State.ChannelVelocities[ch.Channel];
            int velPct = active && !ch.IsMuted ? Math.Clamp((int)Math.Round(vel / 127.0 * 100.0), 12, 100) : 0;
            string ledCls = active ? (ch.IsDrum ? "drum-active" : "active") : "";
            string liveGlow = active && !ch.IsMuted ? "is-live-glow" : "";
            string voiceTitle = string.IsNullOrEmpty(ch.DetectedInstrument) ? ch.Role : ch.DetectedInstrument;

            <div style="--idx: @ch.Channel;"
                 class="channel-strip-card stagger-card glass-card @liveGlow p-1.5 rounded-xl border flex flex-col justify-between space-y-1.5 @(ch.HasNotes ? "" : "opacity-65")">
                <!-- Strip Header: LED + CH + M/S -->
                <div class="flex items-center justify-between gap-1">
                    <div class="flex items-center space-x-1 min-w-0">
                        <span class="meter-led @ledCls w-2 h-2 rounded-full bg-slate-800 border border-slate-700 shrink-0"></span>
                        <span class="text-[10px] font-extrabold font-mono tracking-tight whitespace-nowrap shrink-0" style="color: var(--text-hi);">@(ch.IsDrum ? $"C{ch.Channel + 1}" : $"CH {ch.Channel + 1}")</span>
                        @if (ch.IsDrum)
                        {
                            <span class="strip-drum-pill rounded font-bold bg-amber-950 text-amber-300 border border-amber-700/70 shrink-0">DRUM</span>
                        }
                    </div>
                    <div class="flex items-center space-x-0.5 shrink-0">
                        <button type="button"
                                @onclick="() => Playback.SetChannelMute(ch.Channel, !ch.IsMuted)"
                                title="Mute Ch @(ch.Channel + 1)"
                                class="btn-console-m strip-ms-btn @(ch.IsMuted ? "muted" : "") rounded font-bold bg-slate-800 text-slate-400 border border-slate-700">M</button>
                        <button type="button"
                                @onclick="() => Playback.SetChannelSolo(ch.Channel, !ch.IsSolo)"
                                title="Solo Ch @(ch.Channel + 1)"
                                class="btn-console-s strip-ms-btn @(ch.IsSolo ? "soloed" : "") rounded font-bold bg-slate-800 text-slate-400 border border-slate-700">S</button>
                    </div>
                </div>

                <!-- Detected Source + Voice Selector -->
                <div class="space-y-0.5">
                    <div class="text-[8px] truncate px-0.5" style="color: var(--text-lo);" title="@voiceTitle">
                        @voiceTitle
                        @if (!string.IsNullOrEmpty(ch.InferredSource))
                        {
                            <span class="font-semibold" style="color: var(--acc-hi);"> (@ch.InferredSource)</span>
                        }
                    </div>
                    <div class="flex items-center space-x-0.5">
                        @if (ch.IsDrum)
                        {
                            <div class="hw-vfd w-full px-1 py-0.5 rounded text-[9px] font-bold truncate text-center" style="color: #d97706 !important;">
                                @ch.PssVoiceName.Replace(" (Ch 16)", "")
                            </div>
                        }
                        else
                        {
                            <select @key="@($"{State.ActiveModel}-{ch.Channel}-{State.SelectedSongPath}")"
                                    value="@ch.PssVoice"
                                    @onchange="(e) => OnVoiceChanged(ch.Channel, e.Value?.ToString())"
                                    class="hw-select flex-1 min-w-0 @(ch.IsOverridden ? "border-cyan-500 font-bold" : "") rounded px-1 py-0.5 text-[9px] cursor-pointer truncate">
                                @foreach (var v in voices)
                                {
                                    <option value="@v.Number">@($"{v.Number:D2}: {v.Name}")</option>
                                }
                            </select>
                            @if (ch.IsOverridden)
                            {
                                <button type="button"
                                        @onclick="() => Playback.SetChannelVoiceOverride(ch.Channel, null)"
                                        title="Restore default voice"
                                        class="hw-btn px-1 py-0.5 rounded text-[8px] shrink-0" style="color: var(--acc-hi);">↺</button>
                            }
                        }
                    </div>
                </div>

                <!-- Vertical Fader + Live Velocity Meter Bay -->
                <div class="v-fader-stage hw-bay rounded-lg py-1.5 px-2 flex items-center justify-center space-x-2.5">
                    <!-- Velocity Peak Ladder (Visible etched scale at rest, lit when active) -->
                    <div class="v-meter-groove w-2.5 h-full rounded-full overflow-hidden flex flex-col justify-between p-[1px] relative" title="Live Note Velocity">
                        <div class="w-full h-full flex flex-col justify-end rounded-full overflow-hidden">
                            <div class="v-meter-fill @(ch.IsDrum ? "drum" : "") w-full rounded-full" style="height: @(Math.Max(6, velPct))%; opacity: @(velPct > 0 ? "1" : "0.28");"></div>
                        </div>
                    </div>

                    <!-- Sculpted Vertical Volume Fader with Pointer-Captured 3D Metallic Cap -->
                    <div class="v-fader-track w-2.5 h-full rounded-full flex items-center justify-center relative">
                        <div class="v-fader-input"
                             data-fader-channel="@ch.Channel"
                             role="slider"
                             tabindex="0"
                             aria-label="Channel @(ch.Channel + 1) Volume"
                             aria-valuemin="0"
                             aria-valuemax="100"
                             aria-valuenow="@ch.Volume"></div>
                        <div class="v-fader-fill w-full rounded-full absolute bottom-0 left-0 right-0 pointer-events-none" style="height: @(ch.Volume)%;"></div>
                        <div class="v-fader-cap-visual" style="bottom: @($"{Math.Clamp(ch.Volume * 0.82 + 9, 9, 91):0.#}%");"></div>
                    </div>
                </div>

                <!-- Footer: Octave Shift + VFD Volume Readout -->
                <div class="flex items-center justify-between gap-1">
                    @if (!ch.IsDrum)
                    {
                        <div class="flex items-center space-x-0.5">
                            <button type="button" @onclick="() => Playback.SetChannelOctave(ch.Channel, ch.OctaveShift - 12)" title="Octave Down" class="hw-btn w-4 h-4 rounded flex items-center justify-center text-[9px] font-bold">-</button>
                            <span class="text-[9px] font-mono w-3.5 text-center" style="color: var(--text-mid);" title="Octave Shift">@(ch.OctaveShift / 12)</span>
                            <button type="button" @onclick="() => Playback.SetChannelOctave(ch.Channel, ch.OctaveShift + 12)" title="Octave Up" class="hw-btn w-4 h-4 rounded flex items-center justify-center text-[9px] font-bold">+</button>
                        </div>
                    }
                    else
                    {
                        <span class="text-[8px] font-mono uppercase" style="color: var(--text-lo);">Fixed</span>
                    }
                    <span class="v-fader-readout hw-vfd px-1.5 py-0.2 rounded text-[9px] font-bold text-right shrink-0">@ch.Volume</span>
                </div>
            </div>
        }
    </div>
</section>

@code {
    protected override StateScope SubscribedScopes => StateScope.Channels | StateScope.Transport | StateScope.Shell | StateScope.SoundDesign;

    private DotNetObjectReference<ChannelMixerRack>? _dotNetRef;
    private readonly byte[] _idleVolumes = Enumerable.Repeat((byte)100, 16).ToArray();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
        }
        try
        {
            await JS.InvokeVoidAsync("studioInterop.initMixerFaders", "mixerGrid", _dotNetRef);
        }
        catch { }
    }

    [JSInvokable]
    public void SetFaderVolume(int channel, int volume)
    {
        if ((uint)channel >= 16) return;
        byte vol = (byte)Math.Clamp(volume, 0, 100);
        _idleVolumes[channel] = vol;
        Playback.SetChannelVolume(channel, vol);
    }

    private List<ChannelStateDto> DefaultEmptyChannels()
    {
        bool is680 = string.Equals(State.ActiveModel, "pss680", StringComparison.OrdinalIgnoreCase);
        return Enumerable.Range(0, 16).Select(ch => new ChannelStateDto
        {
            Channel = ch,
            Role = $"Channel {ch + 1}",
            PssVoice = ch == 15 ? (is680 ? 99 : -1) : (is680 ? 3 : 0),
            PssVoiceName = ch == 15 ? (is680 ? "Hand Percussion" : "Fixed Rhythm") : (is680 ? "Piano 1" : "PIANO"),
            IsDrum = ch == 15,
            Volume = _idleVolumes[ch]
        }).ToList();
    }

    private void OnVoiceChanged(int channel, string? rawVal)
    {
        if (int.TryParse(rawVal, out int voice))
        {
            Playback.SetChannelVoiceOverride(channel, voice);
        }
    }

    private void ToggleVectorQuad()
    {
        bool next = !State.VectorQuadPlaybackEnabled;
        SoundDesign.ToggleVectorQuadPlayback(next, State.SelectedMixerVectorPreset);
    }

    private void OnMixerVectorPresetChanged(ChangeEventArgs e)
    {
        var key = e.Value?.ToString() ?? "current";
        State.Mutate(s => s.SelectedMixerVectorPreset = key);
        if (State.VectorQuadPlaybackEnabled)
        {
            SoundDesign.ToggleVectorQuadPlayback(true, key);
        }
    }

    private void SoloDrums()
    {
        Playback.ClearAllSolo();
        int drumCh = State.GmPassthrough ? 9 : 15;
        Playback.SetChannelSolo(drumCh, true);
    }

    private void MuteMelodic()
    {
        Playback.ClearAllSolo();
        int drumCh = State.GmPassthrough ? 9 : 15;
        for (int ch = 0; ch < 16; ch++)
        {
            Playback.SetChannelMute(ch, ch != drumCh);
        }
    }

    private void UnmuteAll()
    {
        Playback.ClearAllSolo();
        for (int ch = 0; ch < 16; ch++) Playback.SetChannelMute(ch, false);
    }

    private void ResetFaders()
    {
        Array.Fill(_idleVolumes, (byte)100);
        for (int ch = 0; ch < 16; ch++) Playback.SetChannelVolume(ch, 100);
    }

    protected override void OnDisposing() => _dotNetRef?.Dispose();
}
