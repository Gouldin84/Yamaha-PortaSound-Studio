@inherits StudioComponentBase
@inject SoundDesignService SoundDesign
@inject IJSRuntime JS

@{
    var sx = State.InspectedSysEx!;
}

<div id="sysexInspectModal" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/80 backdrop-blur-sm p-3">
    <div class="modal-reveal hw-panel glass-panel p-5 sm:p-6 rounded-2xl border border-slate-800 max-w-2xl w-full mx-auto shadow-2xl space-y-4 max-h-[90vh] flex flex-col">
        <div class="flex items-center justify-between border-b border-slate-800 pb-3 shrink-0">
            <div class="flex items-center space-x-2.5 min-w-0">
                <div class="w-8 h-8 rounded-xl bg-indigo-500/20 text-indigo-400 flex items-center justify-center font-bold text-sm shrink-0">🔍</div>
                <div class="min-w-0">
                    <h3 id="sysexInspectTitle" class="text-sm font-bold text-white font-mono truncate">@sx.FileName</h3>
                    <p id="sysexInspectSubtitle" class="text-[11px] text-slate-400">@sx.DumpType &bull; @sx.CreatedAtFormatted</p>
                </div>
            </div>
            <button type="button" @onclick="Close" class="text-slate-400 hover:text-white transition text-lg">✕</button>
        </div>

        <div class="grid grid-cols-3 gap-2 shrink-0 text-center">
            <div class="p-2 rounded-xl bg-slate-900/80 border border-slate-800"><span class="text-[10px] uppercase font-bold text-slate-400 block">Total Size</span><span class="text-sm font-bold text-white font-mono">@sx.FileSizeFormatted</span></div>
            <div class="p-2 rounded-xl bg-slate-900/80 border border-slate-800"><span class="text-[10px] uppercase font-bold text-slate-400 block">SysEx Packets</span><span class="text-sm font-bold text-cyan-400 font-mono">@sx.PacketCount</span></div>
            <div class="p-2 rounded-xl bg-slate-900/80 border border-slate-800"><span class="text-[10px] uppercase font-bold text-slate-400 block">Detected Device</span><span class="text-sm font-bold text-indigo-400">@sx.Manufacturer</span></div>
        </div>

        @if (!string.IsNullOrEmpty(sx.DecodedSummary))
        {
            <div class="p-2.5 rounded-xl bg-emerald-950/40 border border-emerald-700/50 text-xs text-emerald-200 flex flex-wrap items-center justify-between gap-2 shrink-0">
                <span class="font-medium">@sx.DecodedSummary</span>
                <div class="flex items-center space-x-2">
                    @if (sx.CanOpenDrummerGrid)
                    {
                        <button type="button" @onclick="OpenInDrummer" class="hw-key-amber px-2.5 py-1 rounded-lg font-bold text-[11px]">Edit in Drummer Grid</button>
                    }
                    @if (sx.CanExtractMidi)
                    {
                        <button type="button" @onclick="() => SoundDesign.ExtractSysExToMidi(sx.FilePath)" class="hw-key-emerald px-2.5 py-1 rounded-lg font-bold text-[11px]">Extract to .mid</button>
                    }
                </div>
            </div>
        }

        <div class="hw-vfd flex-1 min-h-0 rounded-xl p-3 font-mono text-xs overflow-y-auto custom-scrollbar select-text">
            <pre id="sysexInspectHexContent" class="leading-relaxed whitespace-pre font-mono text-[11px]">@sx.HexPreview</pre>
        </div>

        <div class="flex items-center justify-between border-t pt-3 shrink-0" style="border-color: var(--panel-border);">
            <span class="text-[10px]" style="color: var(--text-lo);">First 512 bytes displayed with ASCII representation</span>
            <div class="flex items-center space-x-2">
                <button type="button" @onclick="CopyHex" class="hw-btn px-3 py-1.5 rounded-xl text-xs font-semibold">@(_copied ? "Copied!" : "Copy Hex")</button>
                <button type="button" @onclick="Close" class="hw-key-indigo px-4 py-1.5 rounded-xl text-xs font-semibold">Done</button>
            </div>
        </div>
    </div>
</div>

@code {
    protected override StateScope SubscribedScopes => StateScope.Modals | StateScope.SoundDesign;

    private bool _copied;

    private void Close() => State.Mutate(s => s.InspectedSysEx = null);

    private void OpenInDrummer()
    {
        var path = State.InspectedSysEx?.FilePath;
        Close();
        if (!string.IsNullOrEmpty(path))
        {
            SoundDesign.LoadDrummerPatternFromSysEx(path);
            State.Mutate(s => s.SysExViewMode = "drums");
        }
    }

    private async Task CopyHex()
    {
        await JS.InvokeVoidAsync("studioInterop.copyToClipboard", State.InspectedSysEx?.HexPreview ?? string.Empty);
        _copied = true;
    }
}
