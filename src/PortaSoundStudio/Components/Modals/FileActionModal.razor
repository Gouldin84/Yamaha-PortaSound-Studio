@inherits StudioComponentBase
@inject LibraryService Library

@{
    var req = State.PendingFileAction!;
    bool isDelete = req.Mode is "delete" or "batch_delete";
    bool isMove = req.Mode is "move" or "batch_move";
    bool isRenameOrFolder = req.Mode is "rename" or "new_folder";

    string title = req.Mode switch
    {
        "new_folder" => "Create New Folder",
        "rename" => req.IsFolder ? "Rename Folder" : "Rename Song",
        "move" => req.IsFolder ? "Move Folder" : "Move Song to Folder",
        "batch_move" => $"Move {req.BatchPaths.Count} Selected Songs",
        "delete" => req.IsFolder ? "Delete Folder" : "Delete Song",
        "batch_delete" => $"Delete {req.BatchPaths.Count} Selected Songs",
        _ => "Library Action"
    };

    var destTree = req.Category == "pss680" ? State.Library.Pss680
                 : req.Category == "pss790" ? State.Library.Pss790
                 : State.Library.Gm;
}

<div id="fileActionModal" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/80 backdrop-blur-sm p-3">
    <div class="glass-panel p-5 rounded-2xl border border-slate-800 max-w-md w-full mx-auto shadow-2xl space-y-4">
        <div class="flex items-center justify-between border-b border-slate-800 pb-2.5">
            <h3 class="text-sm font-bold text-white">@title</h3>
            <button type="button" @onclick="Close" class="text-slate-400 hover:text-white text-lg">✕</button>
        </div>

        <div class="space-y-3 text-xs">
            @if (isRenameOrFolder)
            {
                <div class="space-y-1">
                    <label class="text-slate-400 font-semibold">@(req.Mode == "new_folder" ? "Folder Name" : "New Name")</label>
                    <input type="text" value="@_inputName" @oninput="(e) => _inputName = e.Value?.ToString() ?? string.Empty"
                           class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-cyan-500" />
                </div>
            }

            @if (isMove)
            {
                <div class="space-y-1">
                    <label class="text-slate-400 font-semibold">Target Subfolder (@req.Category.ToUpperInvariant())</label>
                    <select value="@_targetSubFolder" @onchange="(e) => _targetSubFolder = e.Value?.ToString() ?? string.Empty"
                            class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-700 text-white cursor-pointer">
                        <option value="">(Root Folder)</option>
                        @foreach (var f in destTree.AllFolders)
                        {
                            <option value="@f.SubFolder">@f.Display</option>
                        }
                    </select>
                </div>
            }

            @if (isDelete)
            {
                <p class="text-slate-300 leading-relaxed">
                    @if (req.Mode == "batch_delete")
                    {
                        <span>Permanently delete <strong>@req.BatchPaths.Count selected files</strong> from disk?</span>
                    }
                    else
                    {
                        <span>Permanently delete <strong class="text-white">@req.CurrentName</strong> from disk?</span>
                    }
                </p>
            }

            @if (req.HasLinked && (isDelete || (isMove && !req.IsFolder)))
            {
                <label class="flex items-start space-x-2 p-2.5 rounded-xl bg-amber-950/30 border border-amber-700/40 text-amber-200 cursor-pointer">
                    <input type="checkbox" checked="@_applyToLinked" @onchange="(e) => _applyToLinked = e.Value is bool b && b" class="mt-0.5 accent-amber-500" />
                    <span>
                        Also @(isDelete ? "delete" : "move") matching linked files
                        @if (!string.IsNullOrEmpty(req.LinkedName))
                        {
                            <strong>(@req.LinkedName)</strong>
                        }
                    </span>
                </label>
            }
        </div>

        <div class="flex items-center justify-end space-x-2 border-t border-slate-800 pt-3">
            <button type="button" @onclick="Close" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-slate-300">Cancel</button>
            <button type="button" @onclick="Confirm"
                    class="px-5 py-2 rounded-xl @(isDelete ? "bg-rose-600 hover:bg-rose-500" : "bg-cyan-600 hover:bg-cyan-500") text-xs font-bold text-white">
                @(isDelete ? "Delete" : "Apply")
            </button>
        </div>
    </div>
</div>

@code {
    protected override StateScope SubscribedScopes => StateScope.Modals | StateScope.Library | StateScope.Shell;

    private string _inputName = string.Empty;
    private string _targetSubFolder = string.Empty;
    private bool _applyToLinked = true;

    protected override void OnParametersSet()
    {
        var req = State.PendingFileAction;
        if (req != null)
        {
            _inputName = req.Mode == "rename"
                ? (req.IsFolder ? req.CurrentName : Path.GetFileNameWithoutExtension(req.CurrentName))
                : string.Empty;
            _targetSubFolder = req.SubFolder;
            _applyToLinked = req.HasLinked;
        }
    }

    private void Close() => State.Mutate(s => s.PendingFileAction = null);

    private void Confirm()
    {
        var req = State.PendingFileAction;
        if (req == null) return;

        switch (req.Mode)
        {
            case "new_folder":
                Library.CreateFolder(req.SubFolder, _inputName);
                break;
            case "rename":
                Library.RenameItem(req.TargetPath, _inputName, req.IsFolder);
                break;
            case "move":
                if (req.IsFolder)
                    Library.MoveFolder(req.TargetPath, req.Category, _targetSubFolder);
                else
                    Library.MoveFile(req.TargetPath, req.Category, _targetSubFolder, _applyToLinked, req.LinkedPath);
                break;
            case "batch_move":
                Library.BatchMoveFiles(req.BatchPaths, req.Category, _targetSubFolder, _applyToLinked);
                State.Mutate(s => s.SelectedBatchPaths.Clear());
                break;
            case "delete":
                Library.DeleteItem(req.TargetPath, req.IsFolder, _applyToLinked, req.LinkedPath);
                break;
            case "batch_delete":
                Library.BatchDeleteFiles(req.BatchPaths, _applyToLinked);
                State.Mutate(s => s.SelectedBatchPaths.Clear());
                break;
        }
        Close();
    }
}
