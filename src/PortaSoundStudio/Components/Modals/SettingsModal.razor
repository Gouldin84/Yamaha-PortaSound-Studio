@inherits StudioComponentBase
@inject LibraryService Library

<div id="settingsModal" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/80 backdrop-blur-sm p-3">
    <div class="modal-reveal hw-panel glass-panel p-5 sm:p-6 rounded-2xl border border-slate-800 max-w-xl w-full mx-auto shadow-2xl space-y-4 max-h-[90vh] flex flex-col">
        <div class="flex items-center justify-between border-b border-slate-800 pb-3 shrink-0">
            <div class="flex items-center space-x-2.5">
                <div class="w-8 h-8 rounded-xl bg-cyan-500/20 text-cyan-400 flex items-center justify-center font-bold text-sm">⚙️</div>
                <div>
                    <h3 class="text-sm font-bold text-white">Studio Settings</h3>
                    <p class="text-[11px] text-slate-400">Library Storage Location &amp; System Configuration</p>
                </div>
            </div>
            <button type="button" @onclick="Close" class="hw-close-chip w-7 h-7 rounded-lg flex items-center justify-center text-sm font-bold">✕</button>
        </div>

        <div class="flex-1 min-h-0 overflow-y-auto custom-scrollbar space-y-4 pr-1">
            <div class="hw-bay p-3.5 rounded-xl space-y-3">
                <div class="flex items-center justify-between">
                    <label class="text-xs font-bold" style="color: var(--text-hi);">Library Storage Root</label>
                    <span class="hw-btn px-2 py-0.5 rounded-full text-[9px] font-bold">
                        @(State.IsCustomLibraryRoot ? "Custom Path" : "Default Path")
                    </span>
                </div>
                <p class="text-[11px] leading-relaxed" style="color: var(--text-mid);">
                    Specify where your MIDI library, SysEx vaults, and recordings are stored. Supports local folders, mapped drives, and NAS paths.
                </p>
                <div class="flex items-center space-x-2">
                    <input type="text" value="@_rootDraft" @oninput="(e) => _rootDraft = e.Value?.ToString() ?? string.Empty"
                           class="hw-input flex-1 px-3 py-2 rounded-xl text-xs font-mono" />
                    <button type="button" @onclick="Browse" class="hw-btn px-3 py-2 rounded-xl text-xs font-semibold shrink-0">📂 Browse...</button>
                </div>
                <button type="button" @onclick="Reset" class="hw-btn px-2.5 py-1 rounded-lg text-[11px] font-medium cursor-pointer" style="color: var(--acc-hi);">
                    ↺ Reset to Default (@State.DefaultLibraryRoot)
                </button>
            </div>

            <div class="hw-bay p-3.5 rounded-xl space-y-2">
                <span class="text-[10px] font-bold uppercase tracking-wider block" style="color: var(--text-lo);">Managed Directory Structure</span>
                <div class="grid grid-cols-2 gap-2 text-[10px] font-mono">
                    <div class="glass-card p-2 rounded-lg"><span class="text-emerald-400 font-bold block">/GM Midi</span><span class="text-[9px]" style="color: var(--text-lo);">Original GM source files</span></div>
                    <div class="glass-card p-2 rounded-lg"><span class="text-cyan-400 font-bold block">/PSS-790 Midi</span><span class="text-[9px]" style="color: var(--text-lo);">AWM optimized playback</span></div>
                    <div class="glass-card p-2 rounded-lg"><span class="text-amber-400 font-bold block">/PSS-680 Midi</span><span class="text-[9px]" style="color: var(--text-lo);">2-Op FM remapped files</span></div>
                    <div class="glass-card p-2 rounded-lg"><span class="text-indigo-400 font-bold block">/SysEx Library</span><span class="text-[9px]" style="color: var(--text-lo);">FM patches &amp; Vector presets</span></div>
                </div>
            </div>
        </div>

        <div class="flex items-center justify-end space-x-2 border-t pt-3 shrink-0" style="border-color: var(--panel-border);">
            <button type="button" @onclick="Close" class="hw-btn px-4 py-2 rounded-xl text-xs font-semibold">Cancel</button>
            <button type="button" @onclick="Save" class="hw-key-cyan px-5 py-2 rounded-xl text-xs font-bold">Save &amp; Apply</button>
        </div>
    </div>
</div>

@code {
    protected override StateScope SubscribedScopes => StateScope.Modals | StateScope.Library;

    private string _rootDraft = string.Empty;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _rootDraft = State.LibraryRoot;
    }

    private void Browse()
    {
        var picked = Library.BrowseLibraryFolder();
        if (!string.IsNullOrWhiteSpace(picked)) _rootDraft = picked;
    }

    private void Reset()
    {
        Library.ResetLibraryRoot();
        Close();
    }

    private void Save()
    {
        if (!string.IsNullOrWhiteSpace(_rootDraft))
        {
            Library.SaveLibraryRoot(_rootDraft.Trim());
        }
        Close();
    }

    private void Close() => State.Mutate(s => s.ShowSettingsModal = false);
}
