@inherits StudioComponentBase

<div class="fixed bottom-4 right-4 z-[60] flex flex-col space-y-2 max-w-sm pointer-events-none">
    @foreach (var toast in State.Toasts)
    {
        string style = toast.Severity switch
        {
            ToastSeverity.Success => "border-emerald-500/60 text-emerald-200 bg-slate-900/95",
            ToastSeverity.Warning => "border-amber-500/60 text-amber-200 bg-slate-900/95",
            ToastSeverity.Error => "border-rose-500/60 text-rose-200 bg-slate-900/95",
            _ => "border-cyan-500/50 text-slate-100 bg-slate-900/95"
        };
        string icon = toast.Severity switch
        {
            ToastSeverity.Success => "✅",
            ToastSeverity.Warning => "⚠️",
            ToastSeverity.Error => "❌",
            _ => "ℹ️"
        };
        <div id="notificationToast"
             class="pointer-events-auto glass-panel px-3.5 py-2.5 rounded-xl border shadow-2xl flex items-start space-x-2.5 text-xs @style">
            <span class="shrink-0 text-sm">@icon</span>
            <span class="flex-1 leading-snug">@toast.Message</span>
            <button type="button"
                    @onclick="() => State.RemoveToast(toast.Id)"
                    class="text-slate-400 hover:text-white shrink-0 ml-1">✕</button>
        </div>
    }
</div>

@code {
    protected override StateScope SubscribedScopes => StateScope.Modals;
}
