@inherits StudioComponentBase

<div class="fixed bottom-4 right-4 z-[60] flex flex-col space-y-2 max-w-sm pointer-events-none">
    @foreach (var toast in State.Toasts)
    {
        string style = toast.Severity switch
        {
            ToastSeverity.Success => "border-emerald-500/60 text-emerald-300",
            ToastSeverity.Warning => "border-amber-500/60 text-amber-300",
            ToastSeverity.Error => "border-rose-500/60 text-rose-300",
            _ => "border-cyan-500/50"
        };
        string iconName = toast.Severity switch
        {
            ToastSeverity.Success => "check",
            ToastSeverity.Warning => "warning",
            ToastSeverity.Error => "error",
            _ => "info"
        };
        <div id="notificationToast"
             @key="toast.Id"
             class="toast-slide-in hw-panel pointer-events-auto px-3.5 py-2.5 rounded-xl border shadow-2xl flex items-center space-x-2.5 text-xs @style">
            <StudioIcon Name="@iconName" Class="w-4 h-4 shrink-0" />
            <span class="flex-1 leading-snug font-medium" style="color: var(--text-hi);">@toast.Message</span>
            <button type="button"
                    @onclick="() => State.RemoveToast(toast.Id)"
                    class="opacity-70 hover:opacity-100 shrink-0 ml-1 cursor-pointer" style="color: var(--text-mid);">✕</button>
        </div>
    }
</div>

@code {
    protected override StateScope SubscribedScopes => StateScope.Modals;
}
